{
  "name": "local-semantic-cache",
  "version": "1.1.0",
  "description": "Ultra-fast, zero-dependency local semantic cache for LLM/AI prompt responses with built-in TF-IDF vectorizer, vector similarity search, and file persistence.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./openai": {
      "types": "./dist/src/openai.d.ts",
      "default": "./dist/src/openai.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ezeko/semanticcache.git"
  },
  "homepage": "https://github.com/Ezeko/semanticcache#readme",
  "bugs": {
    "url": "https://github.com/Ezeko/semanticcache/issues"
  },
  "files": [
    "dist",
    "openai.js",
    "openai.d.ts",
    "Readme.md",
    "CONTRIBUTING.md",
    "LICENCE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "semanticcache",
    "semantic-cache",
    "ai",
    "llm",
    "cache",
    "openai",
    "gemini",
    "vector-index",
    "vector-database",
    "cosine-similarity",
    "embedding",
    "zero-dependency",
    "better-performance"
  ],
  "author": "Ezekiel Adejobi",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.11.24"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
