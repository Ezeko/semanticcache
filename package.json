{
  "name": "local-semantic-cache",
  "version": "1.0.0",
  "description": "Ultra-fast, zero-dependency local semantic cache for LLM/AI prompt responses with built-in TF-IDF vectorizer, vector similarity search, and file persistence.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "Readme.md",
    "CONTRIBUTING.md",
    "LICENCE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "semanticcache",
    "semantic-cache",
    "ai",
    "llm",
    "cache",
    "openai",
    "gemini",
    "vector-index",
    "vector-database",
    "cosine-similarity",
    "embedding",
    "zero-dependency",
    "better-performance"
  ],
  "author": "Ezekiel Adejobi",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.11.24"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
